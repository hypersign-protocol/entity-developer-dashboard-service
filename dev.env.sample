# Billing (docs/payment/epics.md)
BILLING_ENABLED_REGIONS=
# true: Pay is offered in regions with a gateway (phase 1: IN, Razorpay)
BILLING_PAY_ENABLED=false
# Razorpay API keys (Dashboard > Account & Settings > API Keys); rzp_test_ for sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Merchant name shown in the checkout popup
BILLING_CHECKOUT_NAME=Hypersign
# Our GSTIN's state code (Karnataka)
BILLING_SUPPLIER_STATE_CODE=29
# true: ID Service credits only through invoices (POST /app/:appId/credits returns 409)
BILLING_INVOICED_GRANTS=false
# Our legal entity, printed on invoices ("Billed by")
BILLING_SUPPLIER_LEGAL_NAME=
BILLING_SUPPLIER_EMAIL=
BILLING_SUPPLIER_STREET=
BILLING_SUPPLIER_CITY=
BILLING_SUPPLIER_PROVINCE=
BILLING_SUPPLIER_POSTAL_CODE=
BILLING_SUPPLIER_COUNTRY=IN
BILLING_SUPPLIER_GSTIN=
