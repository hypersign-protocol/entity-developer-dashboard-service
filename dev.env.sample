# Billing (docs/payment/epics.md)
BILLING_ENABLED_REGIONS=
# Razorpay API keys (Dashboard > Account & Settings > API Keys); rzp_test_ for sandbox. Pay is offered only when both are set
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional. Webhook signing secret, the same value as in Razorpay Dashboard > Webhooks (docs/payment/go-live-checklist.md §3.2). Restart after changing it
RAZORPAY_WEBHOOK_SECRET=
# Merchant name shown in the checkout popup
BILLING_CHECKOUT_NAME=Hypersign
